<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- H2 JDBC Driver and connection configuration -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:file:./db/bmitracker;AUTO_SERVER=TRUE;DB_CLOSE_ON_EXIT=FALSE</property>
        <property name="hibernate.connection.username">blackhipohiro</property>
        <property name="hibernate.connection.password"/>

        <!-- H2 Dialect for Hibernate -->
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <!-- Schema generation strategy -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- SQL output logging -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Entity mappings (uncomment once the classes are created in src/main/java) -->
        <!--
        <mapping class="com.bmitracker.domain.model.UserProfile"/>
        <mapping class="com.bmitracker.domain.model.MeasurementEntry"/>
        -->
    </session-factory>
</hibernate-configuration>